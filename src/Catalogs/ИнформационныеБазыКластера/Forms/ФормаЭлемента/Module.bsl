
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяВКластереНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Владелец) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не указан кластер серверов.'"),
			,
			"Владелец");
		Возврат;
	КонецЕсли;
	
	Список = СписокИнформационныхБазКластера(Объект.Владелец);
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Список.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'В кластере нет информационных баз.'"));
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ИмяВКластереВыборЗавершен", ЭтотОбъект);
	ПоказатьВыборИзСписка(Оповещение, Список, Элемент, Список.НайтиПоЗначению(Объект.ИмяВКластере));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Сначала запишите информационную базу.'"));
		Возврат;
	КонецЕсли;
	
	ПроверитьПодключениеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИмяВКластереВыборЗавершен(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ИмяВКластере = ВыбранныйЭлемент.Значение;
КонецПроцедуры

&НаСервере
Процедура ПроверитьПодключениеНаСервере()
	Попытка
		НастройкиАдминистрированияКластеров.ПроверитьПодключение(Объект.Ссылка);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Подключение успешно.'"));
	Исключение
		ОбщегоНазначения.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокИнформационныхБазКластера(Кластер)
	Список = Новый СписокЗначений;
	
	Попытка
		ОписанияБаз = НастройкиАдминистрированияКластеров.ОписанияИнформационныхБазКластера(Кластер);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	Для Каждого ОписаниеБазы Из ОписанияБаз Цикл
		Если ПустаяСтрока(ОписаниеБазы.Описание) Тогда
			Представление = ОписаниеБазы.Имя;
		Иначе
			Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1 (%2)'"),
				ОписаниеБазы.Имя,
				ОписаниеБазы.Описание);
		КонецЕсли;
		Список.Добавить(ОписаниеБазы.Имя, Представление);
	КонецЦикла;
	
	Возврат Список;
КонецФункции

#КонецОбласти
