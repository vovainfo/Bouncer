#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(ПортСервераАдминистрирования) Тогда
		ПортСервераАдминистрирования = 1545;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПортКластера) Тогда
		ПортКластера = 1541;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	ПроверитьДиапазонПорта(ПортСервераАдминистрирования, "ПортСервераАдминистрирования", Отказ);
	ПроверитьДиапазонПорта(ПортКластера, "ПортКластера", Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КластерыСерверов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КластерыСерверов КАК КластерыСерверов
		|ГДЕ
		|	КластерыСерверов.АдресСервераАдминистрирования = &АдресСервераАдминистрирования
		|	И КластерыСерверов.ПортСервераАдминистрирования = &ПортСервераАдминистрирования
		|	И КластерыСерверов.ПортКластера = &ПортКластера
		|	И КластерыСерверов.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("АдресСервераАдминистрирования", АдресСервераАдминистрирования);
	Запрос.УстановитьПараметр("ПортСервераАдминистрирования", ПортСервераАдминистрирования);
	Запрос.УстановитьПараметр("ПортКластера", ПортКластера);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Кластер с таким адресом RAS и портами уже существует.'"),
			ЭтотОбъект,
			"АдресСервераАдминистрирования",
			,
			Отказ);
	КонецЕсли;
КонецПроцедуры
Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Описание = СтрШаблон(
		НСтр("ru = 'Записан кластер %1 (%2:%3, порт кластера %4). Администратор: %5.'"),
		Наименование,
		АдресСервераАдминистрирования,
		Формат(ПортСервераАдминистрирования, "ЧГ=0"),
		Формат(ПортКластера, "ЧГ=0"),
		АдминистраторКластера);
	ПротоколУправленияСеансами.ЗаписатьОперацию(
		Перечисления.ОперацииУправленияСеансами.ИзменениеНастроекАдминистрирования,
		Неопределено,
		Описание,
		Неопределено,
		Истина,
		Ссылка);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДиапазонПорта(Порт, ИмяРеквизита, Отказ)
	Если Порт < 1 Или Порт > 65535 Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Порт должен быть в диапазоне от 1 до 65535.'"),
			ЭтотОбъект,
			ИмяРеквизита,
			,
			Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
