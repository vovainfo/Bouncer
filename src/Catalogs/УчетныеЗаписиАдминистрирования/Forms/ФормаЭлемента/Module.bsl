
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрочитатьПризнакПароля();
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Не ПарольИзменен Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(Пароль) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, Пароль, "Пароль");
	Иначе
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка, "Пароль");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	ПарольИзменен = Ложь;
	ПарольЗадан = ЗначениеЗаполнено(Пароль);
	Пароль = "";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)
	ПарольИзменен = Истина;
	ПарольЗадан = ЗначениеЗаполнено(Пароль);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОчиститьПароль(Команда)
	Пароль = "";
	ПарольИзменен = Истина;
	ПарольЗадан = Ложь;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьПризнакПароля()
	Пароль = "";
	ПарольИзменен = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПарольЗадан = Ложь;
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	СохраненныйПароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Ссылка, "Пароль");
	УстановитьПривилегированныйРежим(Ложь);
	
	ПарольЗадан = ЗначениеЗаполнено(СохраненныйПароль);
КонецПроцедуры

#КонецОбласти
