
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрочитатьПризнакПароля();
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Не ПарольИзменен Тогда
		Возврат;
	КонецЕсли;
	
	ПарольЗаполнен = ЗначениеЗаполнено(Пароль);
	УстановитьПривилегированныйРежим(Истина);
	Если ПарольЗаполнен Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, Пароль, "Пароль");
	Иначе
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка, "Пароль");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ПарольЗаполнен Тогда
		Описание = СтрШаблон(
			НСтр("ru = 'Изменен пароль учетной записи администрирования %1.'"),
			ТекущийОбъект.Наименование);
	Иначе
		Описание = СтрШаблон(
			НСтр("ru = 'Очищен пароль учетной записи администрирования %1.'"),
			ТекущийОбъект.Наименование);
	КонецЕсли;
	ПротоколУправленияСеансами.ЗаписатьОперацию(
		Перечисления.ОперацииУправленияСеансами.ИзменениеНастроекАдминистрирования,
		Неопределено,
		Описание);
	
	ПарольИзменен = Ложь;
	ПарольЗадан = ПарольЗаполнен;
	Пароль = "";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)
	ПарольИзменен = Истина;
	ПарольЗадан = ЗначениеЗаполнено(Пароль);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОчиститьПароль(Команда)
	Пароль = "";
	ПарольИзменен = Истина;
	ПарольЗадан = Ложь;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьПризнакПароля()
	Пароль = "";
	ПарольИзменен = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПарольЗадан = Ложь;
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	СохраненныйПароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Ссылка, "Пароль");
	УстановитьПривилегированныйРежим(Ложь);
	
	ПарольЗадан = ЗначениеЗаполнено(СохраненныйПароль);
КонецПроцедуры

#КонецОбласти
