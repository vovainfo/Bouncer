#Область ПрограммныйИнтерфейс

// Собирает параметры подключения к кластеру через RAS.
//
// Параметры:
//  Кластер - СправочникСсылка.КластерыСерверов
//
// Возвращаемое значение:
//  Структура:
//   * ТипПодключения - Строка
//   * АдресАгентаСервера - Строка
//   * ПортАгентаСервера - Число
//   * АдресСервераАдминистрирования - Строка
//   * ПортСервераАдминистрирования - Число
//   * ПортКластера - Число
//   * ИмяАдминистратораКластера - Строка
//   * ПарольАдминистратораКластера - Строка
//
Функция ПараметрыАдминистрированияКластера(Кластер) Экспорт
	Если Не ЗначениеЗаполнено(Кластер) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан кластер серверов.'");
	КонецЕсли;
	
	РеквизитыКластера = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Кластер,
		"АдресСервераАдминистрирования, ПортСервераАдминистрирования, ПортКластера, АдминистраторКластера");
	
	Результат = АдминистрированиеКластера.ПараметрыАдминистрированияКластера();
	Результат.ТипПодключения = "RAS";
	Результат.АдресСервераАдминистрирования = РеквизитыКластера.АдресСервераАдминистрирования;
	Результат.ПортСервераАдминистрирования = РеквизитыКластера.ПортСервераАдминистрирования;
	Результат.ПортКластера = РеквизитыКластера.ПортКластера;
	
	ДанныеУчетнойЗаписи = ДанныеУчетнойЗаписи(РеквизитыКластера.АдминистраторКластера);
	Результат.ИмяАдминистратораКластера = ДанныеУчетнойЗаписи.ИмяПользователя;
	Результат.ПарольАдминистратораКластера = ДанныеУчетнойЗаписи.Пароль;
	
	Возврат Результат;
КонецФункции

// Собирает параметры администрирования информационной базы кластера.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
// Возвращаемое значение:
//  Структура:
//   * ИмяВКластере - Строка
//   * ИмяАдминистратораИнформационнойБазы - Строка
//   * ПарольАдминистратораИнформационнойБазы - Строка
//
Функция ПараметрыАдминистрированияИнформационнойБазы(ИнформационнаяБаза) Экспорт
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана информационная база кластера.'");
	КонецЕсли;
	
	РеквизитыБазы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнформационнаяБаза,
		"ИмяВКластере, АдминистраторИнформационнойБазы");
	
	Результат = АдминистрированиеКластера.ПараметрыАдминистрированияИнформационнойБазыКластера();
	Результат.ИмяВКластере = РеквизитыБазы.ИмяВКластере;
	
	ДанныеУчетнойЗаписи = ДанныеУчетнойЗаписи(РеквизитыБазы.АдминистраторИнформационнойБазы);
	Результат.ИмяАдминистратораИнформационнойБазы = ДанныеУчетнойЗаписи.ИмяПользователя;
	Результат.ПарольАдминистратораИнформационнойБазы = ДанныеУчетнойЗаписи.Пароль;
	
	Возврат Результат;
КонецФункции
// Возвращает информационные базы кластера по данным сервера администрирования.
//
// Параметры:
//  Кластер - СправочникСсылка.КластерыСерверов
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка
//   * Описание - Строка
//
Функция ОписанияИнформационныхБазКластера(Кластер) Экспорт
	ПараметрыКластера = ПараметрыАдминистрированияКластера(Кластер);
	ИдентификаторКластера = АдминистрированиеКластера.ИдентификаторКластера(ПараметрыКластера);
	СвойстваИнформационныхБаз = АдминистрированиеКластера.СвойстваИнформационныхБаз(
		ИдентификаторКластера,
		ПараметрыКластера);
	
	СписокСортировки = Новый СписокЗначений;
	Для Каждого СвойстваБазы Из СвойстваИнформационныхБаз Цикл
		Имя = Строка(СвойстваБазы["name"]);
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЭлементСписка = СписокСортировки.Добавить();
		ЭлементСписка.Значение = Имя;
		ЭлементСписка.Представление = Строка(СвойстваБазы["descr"]);
	КонецЦикла;
	СписокСортировки.СортироватьПоЗначению();
	
	Результат = Новый Массив;
	Для Каждого ЭлементСписка Из СписокСортировки Цикл
		ОписаниеБазы = Новый Структура("Имя, Описание", ЭлементСписка.Значение, ЭлементСписка.Представление);
		Результат.Добавить(ОписаниеБазы);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Проверяет параметры администрирования кластера и информационной базы.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
Процедура ПроверитьПодключение(ИнформационнаяБаза) Экспорт
	РеквизитыБазы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнформационнаяБаза, "Владелец");
	ПараметрыКластера = ПараметрыАдминистрированияКластера(РеквизитыБазы.Владелец);
	ПараметрыБазы = ПараметрыАдминистрированияИнформационнойБазы(ИнформационнаяБаза);
	
	АдминистрированиеКластера.ПроверитьПараметрыАдминистрирования(ПараметрыКластера, ПараметрыБазы);
КонецПроцедуры

// Проверяет параметры администрирования кластера без проверки информационной базы.
//
// Параметры:
//  Кластер - СправочникСсылка.КластерыСерверов
//
Процедура ПроверитьПодключениеКластера(Кластер) Экспорт
	ПараметрыКластера = ПараметрыАдминистрированияКластера(Кластер);
	АдминистрированиеКластера.ПроверитьПараметрыАдминистрирования(ПараметрыКластера, Неопределено, Истина, Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеУчетнойЗаписи(УчетнаяЗапись)
	Результат = Новый Структура;
	Результат.Вставить("ИмяПользователя", "");
	Результат.Вставить("Пароль", "");
	
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ИмяПользователя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ИмяПользователя");
	
	УстановитьПривилегированныйРежим(Истина);
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(УчетнаяЗапись, "Пароль");
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Пароль <> Неопределено Тогда
		Результат.Пароль = Пароль;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
