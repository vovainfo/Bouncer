#Область СлужебныеПроцедурыИФункции

Функция ОписаниеГруппыДоступаОператора(ИдентификаторПрофиля, ИдентификаторГруппы)
	
	Профиль = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору(ИдентификаторПрофиля);
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не найден поставляемый профиль групп доступа ""%1"".'"),
			ИдентификаторПрофиля);
	КонецЕсли;
	
	НаименованиеПрофиля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Наименование");
	КомментарийПрофиля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Комментарий");
	
	Описание = Новый Структура;
	Описание.Вставить("Профиль", Профиль);
	Описание.Вставить("СсылкаГруппы", Справочники.ГруппыДоступа.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ИдентификаторГруппы)));
	Описание.Вставить("Наименование", НаименованиеПрофиля);
	Описание.Вставить("Комментарий", КомментарийПрофиля);
	
	Возврат Описание;
	
КонецФункции

#КонецОбласти
