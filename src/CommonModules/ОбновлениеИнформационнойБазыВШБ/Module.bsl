#Область СведенияОБиблиотекеИлиКонфигурации

Процедура ПриДобавленииПодсистемы(Описание) Экспорт
	Описание.Имя = "Вышибала";
	Описание.Версия = "1.0.1.3";
	
	// Требуется библиотека стандартных подсистем.
	Описание.ТребуемыеПодсистемы.Добавить("СтандартныеПодсистемы");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОбновленияИнформационнойБазы

Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.0.1.3";
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.РежимВыполнения = "Оперативно";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыВШБ.СоздатьГруппыДоступаОператоровТехподдержки";
	Обработчик.Комментарий = НСтр("ru = 'Создание групп доступа операторов техподдержки.'");
	
КонецПроцедуры

// Создает основные группы доступа по поставляемым профилям операторов техподдержки.
//
Процедура СоздатьГруппыДоступаОператоровТехподдержки() Экспорт
	
	Описания = Новый Массив;
	Описания.Добавить(ОписаниеГруппыДоступаОператора(
		"e31e0989-299d-4f59-9e72-f6c8c1692473",
		"446300cc-c861-443a-a3cc-46307acad54f"));
	Описания.Добавить(ОписаниеГруппыДоступаОператора(
		"d6043cd2-e503-445b-8d09-f6f0b7831834",
		"c90f2ade-c87b-4e1e-bca5-b22e26719203"));
	
	Профили = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Профили.Добавить(Описание.Профиль);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Профили", Профили);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГруппыДоступа.Профиль КАК Профиль,
		|	ГруппыДоступа.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыДоступа КАК ГруппыДоступа
		|ГДЕ
		|	ГруппыДоступа.Профиль В (&Профили)
		|	И НЕ ГруппыДоступа.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();
	СуществующиеПрофили = Новый Соответствие;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СуществующиеПрофили.Вставить(Выборка.Профиль, Выборка.Ссылка);
	КонецЦикла;
	
	Для Каждого Описание Из Описания Цикл
		Если СуществующиеПрофили.Получить(Описание.Профиль) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ОбщегоНазначения.СсылкаСуществует(Описание.СсылкаГруппы) Тогда
			Продолжить;
		КонецЕсли;
		
		ГруппаДоступаОбъект = Справочники.ГруппыДоступа.СоздатьЭлемент();
		ГруппаДоступаОбъект.УстановитьСсылкуНового(Описание.СсылкаГруппы);
		ГруппаДоступаОбъект.Наименование = Описание.Наименование;
		ГруппаДоступаОбъект.Профиль = Описание.Профиль;
		ГруппаДоступаОбъект.Комментарий = Описание.Комментарий;
		ГруппаДоступаОбъект.ОсновнаяГруппаДоступаПоставляемогоПрофиля = Истина;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ГруппаДоступаОбъект);
	КонецЦикла;
	
КонецПроцедуры

