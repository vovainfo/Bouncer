#Область ПрограммныйИнтерфейс

// Возвращает признак права менять блокировку сеансов и регламентных заданий.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноУправлятьБлокировкой() Экспорт
	Возврат Пользователи.ЭтоПолноправныйПользователь();
КонецФункции

// Возвращает признак права завершать сеансы одним пакетным вызовом.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноЗавершатьСеансыПакетно() Экспорт
	Возврат Пользователи.ЭтоПолноправныйПользователь();
КонецФункции

// Возвращает признак права читать состояния и завершать сеансы.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноЗавершатьСеансы() Экспорт
	Возврат Пользователи.ЭтоПолноправныйПользователь()
		Или Пользователи.РолиДоступны("ОператорТехподдержки,ОграниченныйОператорТехподдержки");
КонецФункции

// Возвращает признак доступа ко всем информационным базам без персонального списка.
//
// Возвращаемое значение:
//  Булево
//
Функция ИнформационныеБазыДоступныБезОграничения() Экспорт
	Возврат Пользователи.ЭтоПолноправныйПользователь()
		Или Пользователи.РолиДоступны("ОператорТехподдержки");
КонецФункции

// Возвращает признак разрешения работы с указанной информационной базой.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
// Возвращаемое значение:
//  Булево
//
Функция РазрешенаИнформационнаяБаза(ИнформационнаяБаза) Экспорт
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не МожноЗавершатьСеансы() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИнформационныеБазыДоступныБезОграничения() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат РазрешенныеИнформационныеБазы().Найти(ИнформационнаяБаза) <> Неопределено;
КонецФункции

// Возвращает информационные базы, разрешенные текущему ограниченному оператору.
// Помеченные на удаление базы в список не входят.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ИнформационныеБазыКластера
//
Функция РазрешенныеИнформационныеБазы() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РазрешенныеИнформационныеБазы.ИнформационнаяБаза КАК ИнформационнаяБаза
		|ИЗ
		|	РегистрСведений.РазрешенныеИнформационныеБазы КАК РазрешенныеИнформационныеБазы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнформационныеБазыКластера КАК ИнформационныеБазыКластера
		|		ПО РазрешенныеИнформационныеБазы.ИнформационнаяБаза = ИнформационныеБазыКластера.Ссылка
		|ГДЕ
		|	РазрешенныеИнформационныеБазы.Пользователь = &Пользователь
		|	И НЕ ИнформационныеБазыКластера.ПометкаУдаления";
		Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИнформационнаяБаза");
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

// Вызывает исключение, если нет права читать сеансы или завершать их в указанной базе.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
Процедура ПроверитьПравоЗавершенияСеансов(ИнформационнаяБаза) Экспорт
	Если РазрешенаИнформационнаяБаза(ИнформационнаяБаза) Тогда
		Возврат;
	КонецЕсли;
	
	Описание = НСтр("ru = 'Недостаточно прав для управления сеансами выбранной информационной базы.'");
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(ИнформационнаяБаза, Описание);
	ВызватьИсключение Описание;
КонецПроцедуры

// Вызывает исключение, если нет права менять блокировку сеансов и регламентных заданий.
//
Процедура ПроверитьПравоУправленияБлокировкой() Экспорт
	Если МожноУправлятьБлокировкой() Тогда
		Возврат;
	КонецЕсли;
	
	Описание = НСтр("ru = 'Недостаточно прав для изменения блокировки сеансов и регламентных заданий.'");
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(Неопределено, Описание);
	ВызватьИсключение Описание;
КонецПроцедуры
// Вызывает исключение, если нет права пакетно завершать сеансы в указанной базе.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
Процедура ПроверитьПравоПакетногоЗавершения(ИнформационнаяБаза) Экспорт
	ПроверитьПравоЗавершенияСеансов(ИнформационнаяБаза);
	
	Если МожноЗавершатьСеансыПакетно() Тогда
		Возврат;
	КонецЕсли;
	
	Описание = НСтр("ru = 'Недостаточно прав для пакетного завершения сеансов.'");
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(ИнформационнаяБаза, Описание);
	ВызватьИсключение Описание;
КонецПроцедуры

#КонецОбласти
