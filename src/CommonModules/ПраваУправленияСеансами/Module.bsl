//  Строка
//
Функция ИдентификаторПрофиляОграниченногоОператора() Экспорт
	Возврат "d6043cd2-e503-445b-8d09-f6f0b7831834";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверки прав не учитывают привилегированный режим: результат зависит только от ролей
// пользователя, а не от того, вызвана ли проверка из привилегированного фрагмента кода.

Функция ЭтоПолноправныйПользователь(Пользователь = Неопределено)
	Возврат Пользователи.ЭтоПолноправныйПользователь(Пользователь, , Ложь);
КонецФункции

Функция РолиДоступны(ИменаРолей, Пользователь = Неопределено)
	Возврат Пользователи.РолиДоступны(ИменаРолей, Пользователь, Ложь);
КонецФункции

Процедура ПроверитьПравоНазначенияИнформационныхБаз()
	Если МожноНазначатьИнформационныеБазы() Тогда
		Возврат;
	КонецЕсли;
	
	Описание = НСтр("ru = 'Недостаточно прав для назначения информационных баз операторам.'");
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(Неопределено, Описание);
	ВызватьИсключение Описание;
КонецПроцедуры

#КонецОбласти
