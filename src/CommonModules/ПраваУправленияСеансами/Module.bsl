Функция ИдентификаторПрофиляОператора() Экспорт
	Возврат "e31e0989-299d-4f59-9e72-f6c8c1692473";
КонецФункции

// Возвращает идентификатор поставляемого профиля групп доступа «Ограниченный оператор техподдержки».
//
// Возвращаемое значение:
//  Строка
//
Функция ИдентификаторПрофиляОграниченногоОператора() Экспорт
	Возврат "d6043cd2-e503-445b-8d09-f6f0b7831834";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверки прав не учитывают привилегированный режим: результат зависит только от ролей
// пользователя, а не от того, вызвана ли проверка из привилегированного фрагмента кода.

Функция ЭтоПолноправныйПользователь()
	Возврат Пользователи.ЭтоПолноправныйПользователь(, , Ложь);
КонецФункции

Функция РолиДоступны(ИменаРолей)
	Возврат Пользователи.РолиДоступны(ИменаРолей, , Ложь);
КонецФункции

#КонецОбласти
