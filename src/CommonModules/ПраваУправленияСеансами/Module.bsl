#Область ПрограммныйИнтерфейс

// Возвращает признак права менять блокировку сеансов и регламентных заданий.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноУправлятьБлокировкой() Экспорт
	Возврат ЭтоПолноправныйПользователь();
КонецФункции

// Возвращает признак права завершать сеансы одним пакетным вызовом.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноЗавершатьСеансыПакетно() Экспорт
	Возврат ЭтоПолноправныйПользователь();
КонецФункции

// Возвращает признак права читать состояния и завершать сеансы.
//
// Параметры:
//  Пользователь - Неопределено - текущий пользователь.
//               - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Булево
//
Функция МожноЗавершатьСеансы(Пользователь = Неопределено) Экспорт
	Возврат ЭтоПолноправныйПользователь(Пользователь)
		Или РолиДоступны("ОператорТехподдержки,ОграниченныйОператорТехподдержки", Пользователь);
КонецФункции

// Возвращает признак доступа ко всем информационным базам без персонального списка.
//
// Параметры:
//  Пользователь - Неопределено - текущий пользователь.
//               - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Булево
//
Функция ИнформационныеБазыДоступныБезОграничения(Пользователь = Неопределено) Экспорт
	Возврат ЭтоПолноправныйПользователь(Пользователь)
		Или РолиДоступны("ОператорТехподдержки", Пользователь);
КонецФункции

// Возвращает признак ограниченного оператора: завершать сеансы можно,
// но только в разрешенных информационных базах.
//
// Параметры:
//  Пользователь - Неопределено - текущий пользователь.
//               - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоОграниченныйОператор(Пользователь = Неопределено) Экспорт
	Возврат МожноЗавершатьСеансы(Пользователь)
		И Не ИнформационныеБазыДоступныБезОграничения(Пользователь);
КонецФункции

// Возвращает признак права назначать информационные базы ограниченным операторам.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноНазначатьИнформационныеБазы() Экспорт
	Возврат ЭтоПолноправныйПользователь();
КонецФункции

// Возвращает действующих пользователей, которые по ролям ИБ являются ограниченными операторами.
// Вызывает исключение, если нет права назначать информационные базы.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Пользователи
//
Функция ОграниченныеОператоры() Экспорт
	ПроверитьПравоНазначенияИнформационныхБаз();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Пользователь
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	НЕ Пользователи.ПометкаУдаления
	|	И НЕ Пользователи.Недействителен
	|	И НЕ Пользователи.Служебный
	|	И Пользователи.ИдентификаторПользователяИБ <> &ПустойИдентификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.Наименование";
	Запрос.УстановитьПараметр("ПустойИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	Результат = Новый Массив;
	Для Каждого Пользователь Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь") Цикл
		Если ЭтоОграниченныйОператор(Пользователь) Тогда
			Результат.Добавить(Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Возвращает признак разрешения работы с указанной информационной базой.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
// Возвращаемое значение:
//  Булево
//
Функция РазрешенаИнформационнаяБаза(ИнформационнаяБаза) Экспорт
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не МожноЗавершатьСеансы() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИнформационныеБазыДоступныБезОграничения() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат РазрешенныеИнформационныеБазы().Найти(ИнформационнаяБаза) <> Неопределено;
КонецФункции

// Возвращает информационные базы, разрешенные ограниченному оператору.
// Помеченные на удаление базы в список не входят.
// Список другого пользователя доступен только при праве назначать информационные базы.
//
// Параметры:
//  Пользователь - Неопределено - текущий пользователь.
//               - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ИнформационныеБазыКластера
//
Функция РазрешенныеИнформационныеБазы(Знач Пользователь = Неопределено) Экспорт
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = ТекущийПользователь;
	ИначеЕсли Пользователь <> ТекущийПользователь Тогда
		ПроверитьПравоНазначенияИнформационныхБаз();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РазрешенныеИнформационныеБазы.ИнформационнаяБаза КАК ИнформационнаяБаза
		|ИЗ
		|	РегистрСведений.РазрешенныеИнформационныеБазы КАК РазрешенныеИнформационныеБазы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнформационныеБазыКластера КАК ИнформационныеБазыКластера
		|		ПО РазрешенныеИнформационныеБазы.ИнформационнаяБаза = ИнформационныеБазыКластера.Ссылка
		|ГДЕ
		|	РазрешенныеИнформационныеБазы.Пользователь = &Пользователь
		|	И НЕ ИнформационныеБазыКластера.ПометкаУдаления";
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИнформационнаяБаза");
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

// Заменяет список информационных баз, разрешенных ограниченному оператору.
// Вызывает исключение, если нет права назначать информационные базы.
// Протокол операции пишет модуль набора записей регистра.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//  ИнформационныеБазы - Массив из СправочникСсылка.ИнформационныеБазыКластера - значения
//                       других типов и пустые ссылки пропускаются.
//
Процедура ЗаписатьРазрешенныеИнформационныеБазы(Пользователь, ИнформационныеБазы) Экспорт
	ПроверитьПравоНазначенияИнформационныхБаз();
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан пользователь для назначения информационных баз.'");
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.РазрешенныеИнформационныеБазы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	Для Каждого ИнформационнаяБаза Из ОбщегоНазначенияКлиентСервер.СвернутьМассив(ИнформационныеБазы) Цикл
		Если ТипЗнч(ИнформационнаяБаза) <> Тип("СправочникСсылка.ИнформационныеБазыКластера")
			Или Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
			Продолжить;
		КонецЕсли;
		Запись = НаборЗаписей.Добавить();
		Запись.Пользователь = Пользователь;
		Запись.ИнформационнаяБаза = ИнформационнаяБаза;
	КонецЦикла;
	НаборЗаписей.Записать();
КонецПроцедуры

// Вызывает исключение, если нет права читать сеансы или завершать их в указанной базе.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
Процедура ПроверитьПравоЗавершенияСеансов(ИнформационнаяБаза) Экспорт
	Если РазрешенаИнформационнаяБаза(ИнформационнаяБаза) Тогда
		Возврат;
	КонецЕсли;
	
	Описание = НСтр("ru = 'Недостаточно прав для управления сеансами выбранной информационной базы.'");
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(ИнформационнаяБаза, Описание);
	ВызватьИсключение Описание;
КонецПроцедуры

// Вызывает исключение, если нет права менять блокировку сеансов и регламентных заданий.
//
Процедура ПроверитьПравоУправленияБлокировкой() Экспорт
	Если МожноУправлятьБлокировкой() Тогда
		Возврат;
	КонецЕсли;
	
	Описание = НСтр("ru = 'Недостаточно прав для изменения блокировки сеансов и регламентных заданий.'");
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(Неопределено, Описание);
	ВызватьИсключение Описание;
КонецПроцедуры
// Вызывает исключение, если нет права пакетно завершать сеансы в указанной базе.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
Процедура ПроверитьПравоПакетногоЗавершения(ИнформационнаяБаза) Экспорт
	ПроверитьПравоЗавершенияСеансов(ИнформационнаяБаза);
	
	Если МожноЗавершатьСеансыПакетно() Тогда
		Возврат;
	КонецЕсли;
	
	Описание = НСтр("ru = 'Недостаточно прав для пакетного завершения сеансов.'");
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(ИнформационнаяБаза, Описание);
	ВызватьИсключение Описание;
КонецПроцедуры
// Возвращает признак ограничения завершаемых сеансов по типу клиента.
//
// Возвращаемое значение:
//  Булево
//
Функция ОграничиватьТипЗавершаемогоКлиента() Экспорт
	Возврат ЭтоОграниченныйОператор();
КонецФункции
// Возвращает идентификаторы приложений, которые ограниченный оператор может завершать.
//
// Возвращаемое значение:
//  ФиксированныйМассив из Строка
//
Функция ИдентификаторыКлиентовРазрешенныеКЗавершению() Экспорт
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить("1CV8");
	Идентификаторы.Добавить("1CV8C");
	Идентификаторы.Добавить("1CV8CDirect");
	Возврат Новый ФиксированныйМассив(Идентификаторы);
КонецФункции
// Возвращает признак разрешения завершить сеанс указанного приложения.
//
// Параметры:
//  ИдентификаторПриложения - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция РазрешенИдентификаторКлиентаДляЗавершения(ИдентификаторПриложения) Экспорт
	Если Не ОграничиватьТипЗавершаемогоКлиента() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ИдентификаторыКлиентовРазрешенныеКЗавершению().Найти(ИдентификаторПриложения) <> Неопределено;
КонецФункции

// Возвращает признак права видеть учетные записи администрирования кластеров и баз.
// Формы кластеров и баз скрывают поля учетных записей, если права нет.
//
// Возвращаемое значение:
//  Булево
//
Функция МожноПросматриватьУчетныеЗаписиАдминистрирования() Экспорт
	Возврат ПравоДоступа("Чтение", Метаданные.Справочники.УчетныеЗаписиАдминистрирования);
КонецФункции

