#Область ПрограммныйИнтерфейс

// Возвращает заведенные кластеры и информационные базы со состоянием блокировок RAS.
//
// Параметры:
//  ОпрашиватьКластеры - Булево - если Ложь, состав строится только по справочникам,
//                       без обращения к RAS; колонки блокировок и состояния не заполняются.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Кластер - СправочникСсылка.КластерыСерверов
//   * ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//   * Представление - Строка
//   * БлокировкаСеансов - Булево
//   * БлокировкаРегламентныхЗаданий - Булево
//   * НачалоБлокировки - Дата
//   * ОкончаниеБлокировки - Дата
//   * Состояние - Строка
//
Функция СостоянияИнформационныхБаз(ОпрашиватьКластеры = Истина) Экспорт
	Результат = НоваяТаблицаСостояний();
	ЗаполнитьСостоянияИнформационныхБаз(Результат, ОпрашиватьКластеры);
	Возврат Результат;
КонецФункции

// Возвращает сеансы информационной базы кластера.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Номер - Число
//   * Пользователь - Строка
//   * Компьютер - Строка
//   * Приложение - Строка
//   * ИдентификаторПриложения - Строка
//   * НачалоСеанса - Дата
//   * ПоследняяАктивность - Дата
//   * Спящий - Булево
//
Функция Сеансы(ИнформационнаяБаза) Экспорт
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана информационная база кластера.'");
	КонецЕсли;
	
	ПраваУправленияСеансами.ПроверитьПравоЗавершенияСеансов(ИнформационнаяБаза);
	
	Возврат СеансыИнформационнойБазы(ИнформационнаяБаза);
КонецФункции

// Завершает указанные сеансы по одному вызову БСП на каждый сеанс.
// Сеанс определяется номером, именем пользователя и моментом начала,
// поэтому сеанс, занявший освободившийся номер, не завершается.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//  ЗавершаемыеСеансы - Массив из Структура:
//   * Номер - Число
//   * Пользователь - Строка
//   * НачалоСеанса - Дата
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Номер - Число
//   * Пользователь - Строка
//   * Успешно - Булево
//   * ОписаниеОшибки - Строка
//
Функция ЗавершитьСеансы(ИнформационнаяБаза, ЗавершаемыеСеансы) Экспорт
	ПроверитьПараметрыЗавершения(ИнформационнаяБаза, ЗавершаемыеСеансы);
	ПраваУправленияСеансами.ПроверитьПравоЗавершенияСеансов(ИнформационнаяБаза);
	
	СеансыПоНомерам = Неопределено;
	Если ПраваУправленияСеансами.ОграничиватьТипЗавершаемогоКлиента() Тогда
		СеансыПоНомерам = СеансыПоНомерам(СеансыИнформационнойБазы(ИнформационнаяБаза));
	КонецЕсли;
	
	Результаты = Новый Массив;
	Для Каждого ОписаниеСеанса Из ЗавершаемыеСеансы Цикл
		РезультатСеанса = НовыйРезультатЗавершения(ОписаниеСеанса);
		
		ОписаниеОшибкиДоступа = ОписаниеОшибкиЗавершенияПоТипуКлиента(
			ИнформационнаяБаза, ОписаниеСеанса, СеансыПоНомерам);
		Если ЗначениеЗаполнено(ОписаниеОшибкиДоступа) Тогда
			РезультатСеанса.ОписаниеОшибки = ОписаниеОшибкиДоступа;
			Результаты.Добавить(РезультатСеанса);
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗавершитьСеансыИнформационнойБазы(ИнформационнаяБаза,
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеСеанса));
			РезультатСеанса.Успешно = Истина;
		Исключение
			РезультатСеанса.ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		ЗаписатьРезультатЗавершенияСеанса(ИнформационнаяБаза, РезультатСеанса);
		Результаты.Добавить(РезультатСеанса);
	КонецЦикла;
	
	Возврат Результаты;
КонецФункции
// Завершает указанные сеансы одним вызовом БСП. Доступно только полноправному пользователю.
// Фильтр сравнивает номер, имя пользователя и момент начала независимыми списками,
// поэтому тройка сеанса не проверяется точно: сеанс пройдет фильтр, если каждое его значение
// есть в своем списке. Ложное совпадение возможно, только если сеанс, занявший освободившийся
// номер, начат в ту же секунду, что и один из перечисленных сеансов. Риск принят:
// точный обход RAS потребовал бы внутренних методов БСП.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//  ЗавершаемыеСеансы - Массив из Структура:
//   * Номер - Число
//   * Пользователь - Строка
//   * НачалоСеанса - Дата
//
Процедура ЗавершитьСеансыПакетом(ИнформационнаяБаза, ЗавершаемыеСеансы) Экспорт
	ПроверитьПараметрыЗавершения(ИнформационнаяБаза, ЗавершаемыеСеансы);
	ПраваУправленияСеансами.ПроверитьПравоПакетногоЗавершения(ИнформационнаяБаза);
	
	Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Пакетное завершение сеансов информационной базы %1. Сеансы: %2.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		Строка(ИнформационнаяБаза),
		ПредставлениеСеансов(ЗавершаемыеСеансы));
	
	Попытка
		ЗавершитьСеансыИнформационнойБазы(ИнформационнаяБаза, ЗавершаемыеСеансы);
	Исключение
		ПротоколУправленияСеансами.ЗаписатьОшибку(
			Перечисления.ОперацииУправленияСеансами.ПакетноеЗавершениеСеансов,
			ИнформационнаяБаза,
			ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	ПротоколУправленияСеансами.ЗаписатьОперацию(
		Перечисления.ОперацииУправленияСеансами.ПакетноеЗавершениеСеансов,
		ИнформационнаяБаза,
		Описание);
КонецПроцедуры

// Возвращает настройки блокировки сеансов и регламентных заданий информационной базы.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//
// Возвращаемое значение:
//  Структура:
//   * БлокировкаСеансов - Булево
//   * БлокировкаРегламентныхЗаданий - Булево
//   * НачалоБлокировки - Дата
//   * ОкончаниеБлокировки - Дата
//   * СообщениеБлокировки - Строка
//   * КодРазрешения - Строка
//
Функция НастройкиБлокировки(ИнформационнаяБаза) Экспорт
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана информационная база кластера.'");
	КонецЕсли;
	
	ПраваУправленияСеансами.ПроверитьПравоУправленияБлокировкой();
	
	Результат = НовыеНастройкиБлокировки();
	
	Попытка
		Параметры = ПараметрыАдминистрирования(ИнформационнаяБаза);
		СвойстваБлокировки = АдминистрированиеКластера.БлокировкаСеансовИЗаданийИнформационнойБазы(
			Параметры.ПараметрыКластера,
			Параметры.ПараметрыБазы);
		ЗаполнитьСвойстваБлокировки(Результат, СвойстваБлокировки);
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		ПротоколУправленияСеансами.ЗаписатьОшибку(
			Перечисления.ОперацииУправленияСеансами.ОшибкаАдминистрирования,
			ИнформационнаяБаза,
			СведенияОбОшибке);
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции
// Устанавливает настройки блокировки сеансов и регламентных заданий информационной базы.
//
// Параметры:
//  ИнформационнаяБаза - СправочникСсылка.ИнформационныеБазыКластера
//  Настройки - Структура:
//   * БлокировкаСеансов - Булево
//   * БлокировкаРегламентныхЗаданий - Булево
//   * НачалоБлокировки - Дата
//   * ОкончаниеБлокировки - Дата
//   * СообщениеБлокировки - Строка
//   * КодРазрешения - Строка
//
Процедура УстановитьНастройкиБлокировки(ИнформационнаяБаза, Настройки) Экспорт
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана информационная база кластера.'");
	КонецЕсли;
	
	ПраваУправленияСеансами.ПроверитьПравоУправленияБлокировкой();
	
	Попытка
		Параметры = ПараметрыАдминистрирования(ИнформационнаяБаза);
		СвойстваБлокировки = АдминистрированиеКластера.БлокировкаСеансовИЗаданийИнформационнойБазы(
			Параметры.ПараметрыКластера,
			Параметры.ПараметрыБазы);
		ЗаполнитьСвойстваБлокировкиДляЗаписи(СвойстваБлокировки, Настройки);
		АдминистрированиеКластера.УстановитьБлокировкуСеансовИЗаданийИнформационнойБазы(
			Параметры.ПараметрыКластера,
			Параметры.ПараметрыБазы,
			СвойстваБлокировки);
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		ПротоколУправленияСеансами.ЗаписатьОшибку(
			Перечисления.ОперацииУправленияСеансами.ОшибкаАдминистрирования,
			ИнформационнаяБаза,
			СведенияОбОшибке);
		ВызватьИсключение;
	КонецПопытки;
	
	ЗаписатьИзменениеБлокировки(ИнформационнаяБаза, Настройки);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьСостоянияИнформационныхБаз(Результат, ОпрашиватьКластеры)
	Если Не ПраваУправленияСеансами.МожноЗавершатьСеансы() Тогда
		Возврат;
	КонецЕсли;
	
	ОграничитьСписокБаз = Не ПраваУправленияСеансами.ИнформационныеБазыДоступныБезОграничения();
	РазрешенныеБазы = Новый Массив;
	Если ОграничитьСписокБаз Тогда
		РазрешенныеБазы = ПраваУправленияСеансами.РазрешенныеИнформационныеБазы();
		Если РазрешенныеБазы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КластерыСерверов.Ссылка КАК Кластер,
	|	КластерыСерверов.Наименование КАК Представление
	|ИЗ
	|	Справочник.КластерыСерверов КАК КластерыСерверов
	|ГДЕ
	|	НЕ КластерыСерверов.ПометкаУдаления
	|	И (НЕ &ОграничитьСписокБаз
	|			ИЛИ КластерыСерверов.Ссылка В
	|				(ВЫБРАТЬ
	|					ИнформационныеБазыКластера.Владелец
	|				ИЗ
	|					Справочник.ИнформационныеБазыКластера КАК ИнформационныеБазыКластера
	|				ГДЕ
	|					НЕ ИнформационныеБазыКластера.ПометкаУдаления
	|					И ИнформационныеБазыКластера.Ссылка В (&РазрешенныеБазы)))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Представление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнформационныеБазыКластера.Ссылка КАК ИнформационнаяБаза,
	|	ИнформационныеБазыКластера.Владелец КАК Кластер,
	|	ИнформационныеБазыКластера.Наименование КАК Представление
	|ИЗ
	|	Справочник.ИнформационныеБазыКластера КАК ИнформационныеБазыКластера
	|ГДЕ
	|	НЕ ИнформационныеБазыКластера.ПометкаУдаления
	|	И (НЕ &ОграничитьСписокБаз
	|			ИЛИ ИнформационныеБазыКластера.Ссылка В (&РазрешенныеБазы))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Представление";
	Запрос.УстановитьПараметр("ОграничитьСписокБаз", ОграничитьСписокБаз);
	Запрос.УстановитьПараметр("РазрешенныеБазы", РазрешенныеБазы);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Кластеры = РезультатЗапроса[0].Выгрузить();
	Базы = РезультатЗапроса[1].Выгрузить();
	Базы.Индексы.Добавить("Кластер");
	
	Для Каждого Кластер Из Кластеры Цикл
		ДобавитьСостояниеКластера(Результат, Кластер, Базы, ОпрашиватьКластеры);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьСостояниеКластера(Результат, Кластер, Базы, ОпрашиватьКластеры)
	СтрокаКластера = Результат.Добавить();
	СтрокаКластера.Кластер = Кластер.Кластер;
	СтрокаКластера.Представление = Кластер.Представление;
	
	ПараметрыКластера = Неопределено;
	Если ОпрашиватьКластеры Тогда
		Попытка
			ПараметрыКластера = НастройкиАдминистрированияКластеров.ПараметрыАдминистрированияКластера(Кластер.Кластер);
		Исключение
			СтрокаКластера.Состояние = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	
	ОтборБаз = Новый Структура("Кластер", Кластер.Кластер);
	Для Каждого База Из Базы.НайтиСтроки(ОтборБаз) Цикл
		ДобавитьСостояниеБазы(Результат, База, ПараметрыКластера, СтрокаКластера.Состояние);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьСостояниеБазы(Результат, База, ПараметрыКластера, СостояниеКластера)
	СтрокаБазы = Результат.Добавить();
	СтрокаБазы.Кластер = База.Кластер;
	СтрокаБазы.ИнформационнаяБаза = База.ИнформационнаяБаза;
	СтрокаБазы.Представление = База.Представление;
	
	Если ПараметрыКластера = Неопределено Тогда
		СтрокаБазы.Состояние = СостояниеКластера;
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыБазы = НастройкиАдминистрированияКластеров.ПараметрыАдминистрированияИнформационнойБазы(База.ИнформационнаяБаза);
		СвойстваБлокировки = АдминистрированиеКластера.БлокировкаСеансовИЗаданийИнформационнойБазы(
			ПараметрыКластера,
			ПараметрыБазы);
		ЗаполнитьСвойстваБлокировки(СтрокаБазы, СвойстваБлокировки);
	Исключение
		СтрокаБазы.Состояние = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры

Процедура ЗаполнитьСвойстваБлокировки(Приемник, СвойстваБлокировки)
	Настройки = НовыеНастройкиБлокировки();
	Настройки.БлокировкаСеансов = СвойстваБлокировки.БлокировкаСеансов;
	Настройки.БлокировкаРегламентныхЗаданий = СвойстваБлокировки.БлокировкаРегламентныхЗаданий;
	Настройки.СообщениеБлокировки = Строка(СвойстваБлокировки.Сообщение);
	Настройки.КодРазрешения = Строка(СвойстваБлокировки.КодРазрешения);
	
	Если СвойстваБлокировки.ДатаС <> Неопределено Тогда
		Настройки.НачалоБлокировки = СвойстваБлокировки.ДатаС;
	КонецЕсли;
	
	Если СвойстваБлокировки.ДатаПо <> Неопределено Тогда
		Настройки.ОкончаниеБлокировки = СвойстваБлокировки.ДатаПо;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Приемник, Настройки);
КонецПроцедуры

Функция СеансыИнформационнойБазы(ИнформационнаяБаза)
	Результат = НоваяТаблицаСеансов();
	
	Попытка
		Параметры = ПараметрыАдминистрирования(ИнформационнаяБаза);
		СвойстваСеансов = АдминистрированиеКластера.СеансыИнформационнойБазы(
			Параметры.ПараметрыКластера,
			Параметры.ПараметрыБазы);
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		ПротоколУправленияСеансами.ЗаписатьОшибку(
			Перечисления.ОперацииУправленияСеансами.ОшибкаАдминистрирования,
			ИнформационнаяБаза,
			СведенияОбОшибке);
		ВызватьИсключение;
	КонецПопытки;
	
	Для Каждого СвойстваСеанса Из СвойстваСеансов Цикл
		СтрокаСеанса = Результат.Добавить();
		СтрокаСеанса.Номер = СвойстваСеанса.Номер;
		СтрокаСеанса.Пользователь = Строка(СвойстваСеанса.ИмяПользователя);
		СтрокаСеанса.Компьютер = Строка(СвойстваСеанса.ИмяКлиентскогоКомпьютера);
		СтрокаСеанса.ИдентификаторПриложения = Строка(СвойстваСеанса.ИдентификаторКлиентскогоПриложения);
		СтрокаСеанса.Приложение = ПредставлениеПриложения(СвойстваСеанса.ИдентификаторКлиентскогоПриложения);
		СтрокаСеанса.НачалоСеанса = СвойстваСеанса.МоментСозданияСеанса;
		СтрокаСеанса.ПоследняяАктивность = СвойстваСеанса.МоментПоследнейАктивностиСеанса;
		СтрокаСеанса.Спящий = СвойстваСеанса.Спящий;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Процедура ЗавершитьСеансыИнформационнойБазы(ИнформационнаяБаза, ЗавершаемыеСеансы)
	Параметры = ПараметрыАдминистрирования(ИнформационнаяБаза);
	АдминистрированиеКластера.УдалитьСеансыИнформационнойБазы(
		Параметры.ПараметрыКластера,
		Параметры.ПараметрыБазы,
		ФильтрЗавершаемыхСеансов(ЗавершаемыеСеансы));
КонецПроцедуры

// Для одного сеанса списки из одного значения дают точное совпадение номера,
// имени пользователя и момента начала. Фильтр создается массивом: ДобавитьУсловиеФильтра
// неверно добавляет второе условие к фильтру, созданному условием Равно.
Функция ФильтрЗавершаемыхСеансов(ЗавершаемыеСеансы)
	Фильтр = Новый Массив;
	АдминистрированиеКластера.ДобавитьУсловиеФильтра(Фильтр, "Номер", ВидСравнения.ВСписке,
		ЗначенияСвойстваСеансов(ЗавершаемыеСеансы, "Номер"));
	АдминистрированиеКластера.ДобавитьУсловиеФильтра(Фильтр, "ИмяПользователя", ВидСравнения.ВСписке,
		ЗначенияСвойстваСеансов(ЗавершаемыеСеансы, "Пользователь"));
	АдминистрированиеКластера.ДобавитьУсловиеФильтра(Фильтр, "МоментСозданияСеанса", ВидСравнения.ВСписке,
		ЗначенияСвойстваСеансов(ЗавершаемыеСеансы, "НачалоСеанса"));
	Возврат Фильтр;
КонецФункции
Процедура ПроверитьПараметрыЗавершения(ИнформационнаяБаза, ЗавершаемыеСеансы)
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		ВызватьИсключение НСтр("ru = 'Не указана информационная база кластера.'");
	КонецЕсли;
	
	Если ЗавершаемыеСеансы.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не указаны сеансы для завершения.'");
	КонецЕсли;
КонецПроцедуры
Функция СеансыПоНомерам(ТаблицаСеансов)
	Результат = Новый Соответствие;
	Для Каждого СтрокаСеанса Из ТаблицаСеансов Цикл
		Результат.Вставить(СтрокаСеанса.Номер, СтрокаСеанса);
	КонецЦикла;
	Возврат Результат;
КонецФункции
Функция ОписаниеОшибкиЗавершенияПоТипуКлиента(ИнформационнаяБаза, ОписаниеСеанса, СеансыПоНомерам)
	Если СеансыПоНомерам = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаСеанса = СеансыПоНомерам.Получить(ОписаниеСеанса.Номер);
	Если СтрокаСеанса = Неопределено
		Или СтрокаСеанса.Пользователь <> ОписаниеСеанса.Пользователь
		Или СтрокаСеанса.НачалоСеанса <> ОписаниеСеанса.НачалоСеанса Тогда
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Сеанс %1 пользователя %2 уже завершен.'"),
			Формат(ОписаниеСеанса.Номер, "ЧГ="),
			ОписаниеСеанса.Пользователь);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаСеанса.ИдентификаторПриложения) Тогда
		Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось определить тип клиента сеанса %1. Завершение отклонено.'"),
			Формат(ОписаниеСеанса.Номер, "ЧГ="));
		ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(ИнформационнаяБаза, Описание);
		Возврат Описание;
	КонецЕсли;
	
	Если ПраваУправленияСеансами.РазрешенИдентификаторКлиентаДляЗавершения(
		СтрокаСеанса.ИдентификаторПриложения) Тогда
		Возврат "";
	КонецЕсли;
	
	Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Недостаточно прав для завершения сеанса приложения %1. Ограниченный оператор может завершать только тонкий и толстый клиент.'"),
		СтрокаСеанса.Приложение);
	ПротоколУправленияСеансами.ЗаписатьОтказВДоступе(ИнформационнаяБаза, Описание);
	Возврат Описание;
КонецФункции
Функция НовыйРезультатЗавершения(ОписаниеСеанса)
	Результат = Новый Структура;
	Результат.Вставить("Номер", ОписаниеСеанса.Номер);
	Результат.Вставить("Пользователь", ОписаниеСеанса.Пользователь);
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Возврат Результат;
КонецФункции
Процедура ЗаписатьРезультатЗавершенияСеанса(ИнформационнаяБаза, РезультатСеанса)
	ДанныеСеанса = Новый Структура("Номер, Пользователь", РезультатСеанса.Номер, РезультатСеанса.Пользователь);
	Если РезультатСеанса.Успешно Тогда
		Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Сеанс %1 пользователя %2 информационной базы %3 завершен или уже отсутствовал.'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			Формат(РезультатСеанса.Номер, "ЧГ="),
			РезультатСеанса.Пользователь,
			Строка(ИнформационнаяБаза));
		ПротоколУправленияСеансами.ЗаписатьОперацию(
			Перечисления.ОперацииУправленияСеансами.ЗавершениеСеанса,
			ИнформационнаяБаза,
			Описание,
			ДанныеСеанса);
	Иначе
		Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось завершить сеанс %1 пользователя %2 информационной базы %3. %4'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			Формат(РезультатСеанса.Номер, "ЧГ="),
			РезультатСеанса.Пользователь,
			Строка(ИнформационнаяБаза),
			РезультатСеанса.ОписаниеОшибки);
		ПротоколУправленияСеансами.ЗаписатьОперацию(
			Перечисления.ОперацииУправленияСеансами.ЗавершениеСеанса,
			ИнформационнаяБаза,
			Описание,
			ДанныеСеанса,
			Ложь);
	КонецЕсли;
КонецПроцедуры
Функция ЗначенияСвойстваСеансов(ЗавершаемыеСеансы, ИмяСвойства)
	Результат = Новый Массив;
	Для Каждого ОписаниеСеанса Из ЗавершаемыеСеансы Цикл
		Результат.Добавить(ОписаниеСеанса[ИмяСвойства]);
	КонецЦикла;
	Возврат Результат;
КонецФункции
Функция ПредставлениеСеансов(ЗавершаемыеСеансы)
	Части = Новый Массив;
	Для Каждого ОписаниеСеанса Из ЗавершаемыеСеансы Цикл
		Части.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 (%2)'", ОбщегоНазначения.КодОсновногоЯзыка()),
			Формат(ОписаниеСеанса.Номер, "ЧГ="),
			ОписаниеСеанса.Пользователь));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");
КонецФункции
Процедура ЗаписатьИзменениеБлокировки(ИнформационнаяБаза, Настройки)
	ЭтоСнятие = Не Настройки.БлокировкаСеансов И Не Настройки.БлокировкаРегламентныхЗаданий;
	Если ЭтоСнятие Тогда
		Операция = Перечисления.ОперацииУправленияСеансами.СнятиеБлокировки;
	Иначе
		Операция = Перечисления.ОперацииУправленияСеансами.УстановкаБлокировки;
	КонецЕсли;
	
	Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Информационная база %1. Блокировка сеансов: %2. Блокировка регламентных заданий: %3. Начало: %4. Окончание: %5. Сообщение: %6.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		Строка(ИнформационнаяБаза),
		Настройки.БлокировкаСеансов,
		Настройки.БлокировкаРегламентныхЗаданий,
		Настройки.НачалоБлокировки,
		Настройки.ОкончаниеБлокировки,
		Настройки.СообщениеБлокировки);
	
	ПротоколУправленияСеансами.ЗаписатьОперацию(Операция, ИнформационнаяБаза, Описание);
КонецПроцедуры

Функция ПараметрыАдминистрирования(ИнформационнаяБаза)
	Кластер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИнформационнаяБаза, "Владелец");
	
	Результат = Новый Структура;
	Результат.Вставить("ПараметрыКластера", НастройкиАдминистрированияКластеров.ПараметрыАдминистрированияКластера(Кластер));
	Результат.Вставить("ПараметрыБазы", НастройкиАдминистрированияКластеров.ПараметрыАдминистрированияИнформационнойБазы(ИнформационнаяБаза));
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьСвойстваБлокировкиДляЗаписи(СвойстваБлокировки, Настройки)
	СвойстваБлокировки.БлокировкаСеансов = Настройки.БлокировкаСеансов;
	СвойстваБлокировки.БлокировкаРегламентныхЗаданий = Настройки.БлокировкаРегламентныхЗаданий;
	СвойстваБлокировки.Сообщение = Настройки.СообщениеБлокировки;
	СвойстваБлокировки.КодРазрешения = Настройки.КодРазрешения;
	СвойстваБлокировки.ДатаС = ДатаИлиНеопределено(Настройки.НачалоБлокировки);
	СвойстваБлокировки.ДатаПо = ДатаИлиНеопределено(Настройки.ОкончаниеБлокировки);
КонецПроцедуры

Функция ДатаИлиНеопределено(ДатаЗначение)
	Если Не ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДатаЗначение;
КонецФункции

Функция НовыеНастройкиБлокировки()
	Результат = Новый Структура;
	Результат.Вставить("БлокировкаСеансов", Ложь);
	Результат.Вставить("БлокировкаРегламентныхЗаданий", Ложь);
	Результат.Вставить("НачалоБлокировки", Дата(1, 1, 1));
	Результат.Вставить("ОкончаниеБлокировки", Дата(1, 1, 1));
	Результат.Вставить("СообщениеБлокировки", "");
	Результат.Вставить("КодРазрешения", "");
	
	Возврат Результат;
КонецФункции

Функция НоваяТаблицаСостояний()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Кластер", Новый ОписаниеТипов("СправочникСсылка.КластерыСерверов"));
	Результат.Колонки.Добавить("ИнформационнаяБаза", Новый ОписаниеТипов("СправочникСсылка.ИнформационныеБазыКластера"));
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("БлокировкаСеансов", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("БлокировкаРегламентныхЗаданий", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("НачалоБлокировки", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ОкончаниеБлокировки", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
КонецФункции

Функция НоваяТаблицаСеансов()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Компьютер", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Приложение", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдентификаторПриложения", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НачалоСеанса", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ПоследняяАктивность", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Спящий", Новый ОписаниеТипов("Булево"));
	
	Возврат Результат;
КонецФункции

#КонецОбласти
