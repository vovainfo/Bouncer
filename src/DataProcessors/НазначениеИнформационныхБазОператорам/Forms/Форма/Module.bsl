#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ПраваУправленияСеансами.МожноНазначатьИнформационныеБазы() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Недостаточно прав для назначения информационных баз операторам.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ЗаполнитьФормуНаСервере(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрыть", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы, , ТекстПредупреждения);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОператоры

&НаКлиенте
Процедура ОператорыПриАктивизацииСтроки(Элемент)
	ОтключитьОбработчикОжидания("Подключаемый_ОбработатьСменуОператора");
	ПодключитьОбработчикОжидания("Подключаемый_ОбработатьСменуОператора", 0.2, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоБаз

&НаКлиенте
Процедура ДеревоБазПометкаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДеревоБаз.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Платформа переключает флажок с тремя состояниями по кругу 0, 1, 2.
	// Квадрат пользователь не выбирает: после установленного флажка следует снятый.
	Если ТекущиеДанные.Пометка = 2 Тогда
		ТекущиеДанные.Пометка = 0;
	КонецЕсли;
	
	УзелКластера = ТекущиеДанные.ПолучитьРодителя();
	Если УзелКластера = Неопределено Тогда
		УстановитьПометкуБазКластера(ТекущиеДанные, ТекущиеДанные.Пометка);
	Иначе
		УзелКластера.Пометка = ЗначениеПометкиКластера(УзелКластера);
	КонецЕсли;
	
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	Если Не ЗначениеЗаполнено(ТекущийОператор) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьОтметки();
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Назначение информационных баз записано'"),
		,
		Строка(ТекущийОператор));
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	Если Модифицированность Тогда
		ЗапроситьЗаписьИзменений(Новый ОписаниеОповещения("ОбновитьЗавершение", ЭтотОбъект));
		Возврат;
	КонецЕсли;
	
	ЗаполнитьФормуНаСервере(ТекущийОператор);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьПометкуВсехБаз(1);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеОтметки(Команда)
	УстановитьПометкуВсехБаз(0);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Результат, ДополнительныеПараметры) Экспорт
	ЗаписатьОтметки();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если ОбработатьОтветНаВопросОЗаписи(Ответ) Тогда
		ЗаполнитьФормуНаСервере(ТекущийОператор);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СменаОператораЗавершение(Ответ, НовыйОператор) Экспорт
	Если ОбработатьОтветНаВопросОЗаписи(Ответ) Тогда
		ЗагрузитьОтметкиНаСервере(НовыйОператор);
	Иначе
		// Строка вернется к текущему оператору, повторная активизация ничего не изменит.
		АктивизироватьСтрокуОператора(ТекущийОператор);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьСменуОператора()
	Если ОжидаетсяОтветНаВопрос Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Операторы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Пользователь = ТекущийОператор Тогда
		Возврат;
	КонецЕсли;
	
	НовыйОператор = ТекущиеДанные.Пользователь;
	Если Не Модифицированность Тогда
		ЗагрузитьОтметкиНаСервере(НовыйОператор);
		Возврат;
	КонецЕсли;
	
	// До ответа отметки в дереве принадлежат текущему оператору.
	ЗапроситьЗаписьИзменений(Новый ОписаниеОповещения("СменаОператораЗавершение", ЭтотОбъект, НовыйОператор));
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьЗаписьИзменений(ОповещениеОЗавершении)
	ОжидаетсяОтветНаВопрос = Истина;
	ПоказатьВопрос(
		ОповещениеОЗавершении,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Назначение информационных баз оператору %1 изменено. Записать изменения?'"),
			ТекущийОператор),
		РежимДиалогаВопрос.ДаНетОтмена);
КонецПроцедуры

// Возвращает Истина, если действие можно продолжать: изменения записаны или отброшены.
//
&НаКлиенте
Функция ОбработатьОтветНаВопросОЗаписи(Ответ)
	ОжидаетсяОтветНаВопрос = Ложь;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьОтметки();
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ответ = КодВозвратаДиалога.Нет;
КонецФункции

&НаКлиенте
Процедура АктивизироватьСтрокуОператора(Оператор)
	НайденныеСтроки = Операторы.НайтиСтроки(Новый Структура("Пользователь", Оператор));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Элементы.Операторы.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтметки()
	Если Не ЗначениеЗаполнено(ТекущийОператор) Тогда
		Возврат;
	КонецЕсли;
	
	// В регистр попадают только базы: узлы кластеров пропускаются.
	ИнформационныеБазы = Новый Массив;
	Для Каждого УзелКластера Из ДеревоБаз.ПолучитьЭлементы() Цикл
		Для Каждого УзелБазы Из УзелКластера.ПолучитьЭлементы() Цикл
			Если УзелБазы.Пометка = 1 Тогда
				ИнформационныеБазы.Добавить(УзелБазы.Объект);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗаписатьОтметкиНаСервере(ТекущийОператор, ИнформационныеБазы);
	Модифицированность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуВсехБаз(Пометка)
	Если Не ЗначениеЗаполнено(ТекущийОператор) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого УзелКластера Из ДеревоБаз.ПолучитьЭлементы() Цикл
		УстановитьПометкуБазКластера(УзелКластера, Пометка);
	КонецЦикла;
	
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПометкуБазКластера(УзелКластера, Пометка)
	Для Каждого УзелБазы Из УзелКластера.ПолучитьЭлементы() Цикл
		УзелБазы.Пометка = Пометка;
	КонецЦикла;
	УзелКластера.Пометка = ЗначениеПометкиКластера(УзелКластера);
КонецПроцедуры

// Возвращает пометку кластера по его базам: 1 - отмечены все, 0 - ни одной или баз нет, 2 - часть.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеПометкиКластера(УзелКластера)
	ЕстьОтмеченные = Ложь;
	ЕстьНеотмеченные = Ложь;
	Для Каждого УзелБазы Из УзелКластера.ПолучитьЭлементы() Цикл
		Если УзелБазы.Пометка = 1 Тогда
			ЕстьОтмеченные = Истина;
		Иначе
			ЕстьНеотмеченные = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОтмеченные И ЕстьНеотмеченные Тогда
		Возврат 2;
	ИначеЕсли ЕстьОтмеченные Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат 0;
КонецФункции

&НаСервере
Процедура ЗаполнитьФормуНаСервере(ПредпочтительныйОператор)
	Операторы.Очистить();
	Для Каждого Оператор Из ПраваУправленияСеансами.ОграниченныеОператоры() Цикл
		Операторы.Добавить().Пользователь = Оператор;
	КонецЦикла;
	
	ЗаполнитьДеревоБазНаСервере();
	
	СтрокаОператора = Неопределено;
	НайденныеСтроки = Операторы.НайтиСтроки(Новый Структура("Пользователь", ПредпочтительныйОператор));
	Если НайденныеСтроки.Количество() > 0 Тогда
		СтрокаОператора = НайденныеСтроки[0];
	ИначеЕсли Операторы.Количество() > 0 Тогда
		СтрокаОператора = Операторы[0];
	КонецЕсли;
	
	Оператор = Неопределено;
	Если СтрокаОператора <> Неопределено Тогда
		Элементы.Операторы.ТекущаяСтрока = СтрокаОператора.ПолучитьИдентификатор();
		Оператор = СтрокаОператора.Пользователь;
	КонецЕсли;
	
	ЗагрузитьОтметкиНаСервере(Оператор);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоБазНаСервере()
	// Состояния идут кластер за кластером: строка кластера, затем строки его баз.
	Состояния = СеансыИнформационныхБаз.СостоянияИнформационныхБаз(Ложь);
	Дерево = РеквизитФормыВЗначение("ДеревоБаз");
	Дерево.Строки.Очистить();
	
	УзелКластера = Неопределено;
	Для Каждого СтрокаСостояния Из Состояния Цикл
		Если ЗначениеЗаполнено(СтрокаСостояния.ИнформационнаяБаза) Тогда
			УзелБазы = УзелКластера.Строки.Добавить();
			УзелБазы.Объект = СтрокаСостояния.ИнформационнаяБаза;
			УзелБазы.Представление = СтрокаСостояния.Представление;
		Иначе
			УзелКластера = Дерево.Строки.Добавить();
			УзелКластера.Объект = СтрокаСостояния.Кластер;
			УзелКластера.Представление = СтрокаСостояния.Представление;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоБаз");
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОтметкиНаСервере(Оператор)
	РазрешенныеБазы = Новый Массив;
	Если ЗначениеЗаполнено(Оператор) Тогда
		РазрешенныеБазы = ПраваУправленияСеансами.РазрешенныеИнформационныеБазы(Оператор);
	КонецЕсли;
	
	Для Каждого УзелКластера Из ДеревоБаз.ПолучитьЭлементы() Цикл
		Для Каждого УзелБазы Из УзелКластера.ПолучитьЭлементы() Цикл
			УзелБазы.Пометка = ?(РазрешенныеБазы.Найти(УзелБазы.Объект) = Неопределено, 0, 1);
		КонецЦикла;
		УзелКластера.Пометка = ЗначениеПометкиКластера(УзелКластера);
	КонецЦикла;
	
	ТекущийОператор = Оператор;
	Элементы.ДеревоБаз.ТолькоПросмотр = Не ЗначениеЗаполнено(Оператор);
	// Отметки загружены программно: изменений пользователя нет.
	Модифицированность = Ложь;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьОтметкиНаСервере(Оператор, ИнформационныеБазы)
	ПраваУправленияСеансами.ЗаписатьРазрешенныеИнформационныеБазы(Оператор, ИнформационныеБазы);
КонецПроцедуры

#КонецОбласти
