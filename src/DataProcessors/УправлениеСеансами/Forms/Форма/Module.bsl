#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьДеревоНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоБаз

&НаКлиенте
Процедура ДеревоБазПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.ДеревоБаз.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОчиститьСеансыНаКлиенте();
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Объект) <> Тип("СправочникСсылка.ИнформационныеБазыКластера") Тогда
		ОчиститьСеансыНаКлиенте();
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Объект = ТекущаяИнформационнаяБаза Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСеансыНаКлиенте(ТекущиеДанные.Объект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСостояние(Команда)
	ТекущийОбъект = Неопределено;
	ТекущиеДанные = Элементы.ДеревоБаз.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущийОбъект = ТекущиеДанные.Объект;
	КонецЕсли;
	
	ТекущаяИнформационнаяБаза = Неопределено;
	ЗаполнитьДеревоНаСервере(ТекущийОбъект);
	ДеревоБазПриАктивизацииСтроки(Элементы.ДеревоБаз);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСеансы(Команда)
	Если Не ЗначениеЗаполнено(ТекущаяИнформационнаяБаза) Тогда
		ОчиститьСеансыНаКлиенте();
		Возврат;
	КонецЕсли;
	
	ИнформационнаяБаза = ТекущаяИнформационнаяБаза;
	ТекущаяИнформационнаяБаза = Неопределено;
	ЗаполнитьСеансыНаКлиенте(ИнформационнаяБаза);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПомеченныеСеансы(Команда)
	Если Не ЗначениеЗаполнено(ТекущаяИнформационнаяБаза) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите информационную базу.'"));
		Возврат;
	КонецЕсли;
	
	НомераСеансов = НомераПомеченныхСеансов();
	Если НомераСеансов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отметьте сеансы для завершения.'"));
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(НСтр("ru = 'Завершить отмеченные сеансы (%1)?'"), НомераСеансов.Количество());
	Оповещение = Новый ОписаниеОповещения("ЗавершитьПомеченныеСеансыЗавершение", ЭтотОбъект, НомераСеансов);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьПомеченныеСеансыЗавершение(Результат, НомераСеансов) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗавершитьСеансыНаСервере(ТекущаяИнформационнаяБаза, НомераСеансов);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ИнформационнаяБаза = ТекущаяИнформационнаяБаза;
	ТекущаяИнформационнаяБаза = Неопределено;
	ЗаполнитьСеансыНаКлиенте(ИнформационнаяБаза);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСеансыНаКлиенте(ИнформационнаяБаза)
	Попытка
		СеансыБазы = СеансыНаСервере(ИнформационнаяБаза);
	Исключение
		Сеансы.Очистить();
		ТекущаяИнформационнаяБаза = ИнформационнаяБаза;
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Сеансы.Очистить();
	Для Каждого СтрокаСеанса Из СеансыБазы Цикл
		НоваяСтрока = Сеансы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСеанса);
	КонецЦикла;
	
	ТекущаяИнформационнаяБаза = ИнформационнаяБаза;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСеансыНаКлиенте()
	Сеансы.Очистить();
	ТекущаяИнформационнаяБаза = Неопределено;
КонецПроцедуры

&НаКлиенте
Функция НомераПомеченныхСеансов()
	НомераСеансов = Новый Массив;
	Для Каждого СтрокаСеанса Из Сеансы Цикл
		Если СтрокаСеанса.Пометка Тогда
			НомераСеансов.Добавить(СтрокаСеанса.Номер);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НомераСеансов;
КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоНаСервере(ТекущийОбъект = Неопределено)
	Состояния = СеансыИнформационныхБаз.СостоянияИнформационныхБаз();
	Дерево = РеквизитФормыВЗначение("ДеревоБаз");
	Дерево.Строки.Очистить();
	
	УзлыКластеров = Новый Соответствие;
	Для Каждого СтрокаСостояния Из Состояния Цикл
		Если ЗначениеЗаполнено(СтрокаСостояния.ИнформационнаяБаза) Тогда
			Продолжить;
		КонецЕсли;
		УзелКластера = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(УзелКластера, СтрокаСостояния);
		УзелКластера.Объект = СтрокаСостояния.Кластер;
		УзлыКластеров.Вставить(СтрокаСостояния.Кластер, УзелКластера);
	КонецЦикла;
	
	Для Каждого СтрокаСостояния Из Состояния Цикл
		Если Не ЗначениеЗаполнено(СтрокаСостояния.ИнформационнаяБаза) Тогда
			Продолжить;
		КонецЕсли;
		УзелКластера = УзлыКластеров.Получить(СтрокаСостояния.Кластер);
		Если УзелКластера = Неопределено Тогда
			УзелКластера = Дерево.Строки.Добавить();
			УзелКластера.Объект = СтрокаСостояния.Кластер;
			УзелКластера.Представление = Строка(СтрокаСостояния.Кластер);
			УзлыКластеров.Вставить(СтрокаСостояния.Кластер, УзелКластера);
		КонецЕсли;
		УзелБазы = УзелКластера.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(УзелБазы, СтрокаСостояния);
		УзелБазы.Объект = СтрокаСостояния.ИнформационнаяБаза;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоБаз");
	ВосстановитьТекущуюСтрокуДерева(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ВосстановитьТекущуюСтрокуДерева(ТекущийОбъект)
	Если Не ЗначениеЗаполнено(ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = ИдентификаторСтрокиДерева(ДеревоБаз.ПолучитьЭлементы(), ТекущийОбъект);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.ДеревоБаз.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ИдентификаторСтрокиДерева(СтрокиДерева, ИскомыйОбъект)
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.Объект = ИскомыйОбъект Тогда
			Возврат СтрокаДерева.ПолучитьИдентификатор();
		КонецЕсли;
		НайденныйИдентификатор = ИдентификаторСтрокиДерева(СтрокаДерева.ПолучитьЭлементы(), ИскомыйОбъект);
		Если НайденныйИдентификатор <> Неопределено Тогда
			Возврат НайденныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция СеансыНаСервере(ИнформационнаяБаза)
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(СеансыИнформационныхБаз.Сеансы(ИнформационнаяБаза));
КонецФункции

&НаСервереБезКонтекста
Процедура ЗавершитьСеансыНаСервере(ИнформационнаяБаза, НомераСеансов)
	СеансыИнформационныхБаз.ЗавершитьСеансы(ИнформационнаяБаза, НомераСеансов);
КонецПроцедуры

#КонецОбласти
