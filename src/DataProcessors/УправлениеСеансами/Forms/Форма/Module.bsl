#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МожноУправлятьБлокировкой = ПраваУправленияСеансами.МожноУправлятьБлокировкой();
	Элементы.ГруппаУправление.Видимость = МожноУправлятьБлокировкой;
	Элементы.ГруппаУправление.Доступность = Ложь;
	Элементы.ЗавершитьСеансыПакетом.Видимость = ПраваУправленияСеансами.МожноЗавершатьСеансыПакетно();
	ОграничиватьТипКлиента = ПраваУправленияСеансами.ОграничиватьТипЗавершаемогоКлиента();
	ЗаполнитьДеревоНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоБаз

&НаКлиенте
Процедура ДеревоБазПриАктивизацииСтроки(Элемент)
	ОбновитьСеансыПоТекущейСтрокеДерева();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСеансы

&НаКлиенте
Процедура СеансыПометкаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Сеансы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Пометка И Не ТекущиеДанные.МожноЗавершать Тогда
		ТекущиеДанные.Пометка = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Ограниченный оператор может завершать только тонкий и толстый клиент.'"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСостояние(Команда)
	ТекущийОбъект = Неопределено;
	ТекущиеДанные = Элементы.ДеревоБаз.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущийОбъект = ТекущиеДанные.Объект;
	КонецЕсли;
	
	ТекущаяИнформационнаяБаза = Неопределено;
	ЗаполнитьДеревоНаСервере(ТекущийОбъект);
	ОбновитьСеансыПоТекущейСтрокеДерева();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСеансы(Команда)
	Если Не ЗначениеЗаполнено(ТекущаяИнформационнаяБаза) Тогда
		ОчиститьСеансыНаКлиенте();
		Возврат;
	КонецЕсли;
	
	ИнформационнаяБаза = ТекущаяИнформационнаяБаза;
	ТекущаяИнформационнаяБаза = Неопределено;
	ЗаполнитьСеансыНаКлиенте(ИнформационнаяБаза);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПомеченныеСеансы(Команда)
	ЗавершаемыеСеансы = ПомеченныеСеансы();
	Если Не НачатьЗавершениеСеансов(ЗавершаемыеСеансы) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(НСтр("ru = 'Завершить отмеченные сеансы (%1)?'"), ЗавершаемыеСеансы.Количество());
	Оповещение = Новый ОписаниеОповещения("ЗавершитьПомеченныеСеансыЗавершение", ЭтотОбъект, ЗавершаемыеСеансы);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры
&НаКлиенте
Процедура ЗавершитьСеансыПакетом(Команда)
	ЗавершаемыеСеансы = ПомеченныеСеансы();
	Если Не НачатьЗавершениеСеансов(ЗавершаемыеСеансы) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Завершить отмеченные сеансы (%1) одним пакетным вызовом? Результат по каждому сеансу недоступен.'"),
		ЗавершаемыеСеансы.Количество());
	Оповещение = Новый ОписаниеОповещения("ЗавершитьСеансыПакетомЗавершение", ЭтотОбъект, ЗавершаемыеСеансы);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПометитьВсе(Команда)
	УстановитьПометкиСеансов(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеПометки(Команда)
	УстановитьПометкиСеансов(Ложь);
КонецПроцедуры
&НаКлиенте
Процедура ПрименитьНастройкиБлокировки(Команда)
	Если Не ЗначениеЗаполнено(ТекущаяИнформационнаяБаза) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите информационную базу.'"));
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НачалоБлокировки)
		И ЗначениеЗаполнено(ОкончаниеБлокировки)
		И ОкончаниеБлокировки < НачалоБлокировки Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Окончание блокировки не может быть раньше начала.'"));
		Возврат;
	КонецЕсли;
	
	Настройки = Новый Структура;
	Настройки.Вставить("БлокировкаСеансов", БлокировкаСеансов);
	Настройки.Вставить("БлокировкаРегламентныхЗаданий", БлокировкаРегламентныхЗаданий);
	Настройки.Вставить("НачалоБлокировки", НачалоБлокировки);
	Настройки.Вставить("ОкончаниеБлокировки", ОкончаниеБлокировки);
	Настройки.Вставить("СообщениеБлокировки", СообщениеБлокировки);
	Настройки.Вставить("КодРазрешения", КодРазрешения);
	
	Попытка
		Настройки = УстановитьНастройкиБлокировкиНаСервере(ТекущаяИнформационнаяБаза, Настройки);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);
	ОбновитьКолонкиБлокировкиВДереве(Настройки);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьПомеченныеСеансыЗавершение(Результат, ЗавершаемыеСеансы) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Результаты = ЗавершитьСеансыНаСервере(ТекущаяИнформационнаяБаза, ЗавершаемыеСеансы);
		ПоказатьРезультатыЗавершения(Результаты);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ОбновитьСписокСеансовПослеЗавершения();
КонецПроцедуры
&НаКлиенте
Процедура ЗавершитьСеансыПакетомЗавершение(Результат, ЗавершаемыеСеансы) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗавершитьСеансыПакетомНаСервере(ТекущаяИнформационнаяБаза, ЗавершаемыеСеансы);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ОбновитьСписокСеансовПослеЗавершения();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСеансыПоТекущейСтрокеДерева()
	ТекущиеДанные = Элементы.ДеревоБаз.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОчиститьСеансыНаКлиенте();
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Объект) <> Тип("СправочникСсылка.ИнформационныеБазыКластера") Тогда
		ОчиститьСеансыНаКлиенте();
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Объект = ТекущаяИнформационнаяБаза Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСеансыНаКлиенте(ТекущиеДанные.Объект);
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьСеансыНаКлиенте(ИнформационнаяБаза)
	Попытка
		СеансыБазы = СеансыНаСервере(ИнформационнаяБаза);
	Исключение
		Сеансы.Очистить();
		ТекущаяИнформационнаяБаза = ИнформационнаяБаза;
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаполнитьНастройкиБлокировкиНаКлиенте(ИнформационнаяБаза);
		Возврат;
	КонецПопытки;
	
	Сеансы.Очистить();
	Для Каждого СтрокаСеанса Из СеансыБазы Цикл
		НоваяСтрока = Сеансы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСеанса);
	КонецЦикла;
	
	ТекущаяИнформационнаяБаза = ИнформационнаяБаза;
	ЗаполнитьНастройкиБлокировкиНаКлиенте(ИнформационнаяБаза);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСеансыНаКлиенте()
	Сеансы.Очистить();
	ТекущаяИнформационнаяБаза = Неопределено;
	ОчиститьНастройкиБлокировкиНаКлиенте();
КонецПроцедуры

&НаКлиенте
Функция ПомеченныеСеансы()
	Результат = Новый Массив;
	Для Каждого СтрокаСеанса Из Сеансы Цикл
		Если Не СтрокаСеанса.Пометка Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеСеанса = Новый Структура("Номер, Пользователь", СтрокаСеанса.Номер, СтрокаСеанса.Пользователь);
		Результат.Добавить(ОписаниеСеанса);
	КонецЦикла;
	Возврат Результат;
КонецФункции
&НаКлиенте
Функция НачатьЗавершениеСеансов(ЗавершаемыеСеансы)
	Если Не ЗначениеЗаполнено(ТекущаяИнформационнаяБаза) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите информационную базу.'"));
		Возврат Ложь;
	КонецЕсли;
	
	БылиПометки = ЗавершаемыеСеансы.Количество() > 0;
	Если ОграничиватьТипКлиента Тогда
		ИсключитьСеансыЗапрещенногоТипа(ЗавершаемыеСеансы);
	КонецЕсли;
	
	Если ЗавершаемыеСеансы.Количество() = 0 Тогда
		Если БылиПометки Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Ограниченный оператор может завершать только тонкий и толстый клиент.'"));
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отметьте сеансы, которые нужно завершить.'"));
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции
&НаКлиенте
Процедура ИсключитьСеансыЗапрещенногоТипа(ЗавершаемыеСеансы)
	РазрешенныеНомера = Новый Соответствие;
	Для Каждого СтрокаСеанса Из Сеансы Цикл
		Если СтрокаСеанса.Пометка И Не СтрокаСеанса.МожноЗавершать Тогда
			СтрокаСеанса.Пометка = Ложь;
		КонецЕсли;
		Если СтрокаСеанса.МожноЗавершать Тогда
			РазрешенныеНомера.Вставить(СтрокаСеанса.Номер, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Индекс = ЗавершаемыеСеансы.ВГраница();
	Пока Индекс >= 0 Цикл
		Если РазрешенныеНомера.Получить(ЗавершаемыеСеансы[Индекс].Номер) = Неопределено Тогда
			ЗавершаемыеСеансы.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры
&НаКлиенте
Процедура ПоказатьРезультатыЗавершения(Результаты)
	Для Каждого РезультатСеанса Из Результаты Цикл
		Если РезультатСеанса.Успешно Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось завершить сеанс %1 (%2): %3'"),
			РезультатСеанса.Номер,
			РезультатСеанса.Пользователь,
			РезультатСеанса.ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;
КонецПроцедуры
&НаКлиенте
Процедура ОбновитьСписокСеансовПослеЗавершения()
	Если Не ЗначениеЗаполнено(ТекущаяИнформационнаяБаза) Тогда
		Возврат;
	КонецЕсли;
	
	ИнформационнаяБаза = ТекущаяИнформационнаяБаза;
	ТекущаяИнформационнаяБаза = Неопределено;
	ЗаполнитьСеансыНаКлиенте(ИнформационнаяБаза);
КонецПроцедуры
&НаКлиенте
Процедура УстановитьПометкиСеансов(Пометка)
	Для Каждого СтрокаСеанса Из Сеансы Цикл
		Если Пометка И Не СтрокаСеанса.МожноЗавершать Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСеанса.Пометка = Пометка;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоНаСервере(ТекущийОбъект = Неопределено)
	Состояния = СеансыИнформационныхБаз.СостоянияИнформационныхБаз();
	Дерево = РеквизитФормыВЗначение("ДеревоБаз");
	Дерево.Строки.Очистить();
	
	УзлыКластеров = Новый Соответствие;
	Для Каждого СтрокаСостояния Из Состояния Цикл
		Если ЗначениеЗаполнено(СтрокаСостояния.ИнформационнаяБаза) Тогда
			Продолжить;
		КонецЕсли;
		УзелКластера = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(УзелКластера, СтрокаСостояния);
		УзелКластера.Объект = СтрокаСостояния.Кластер;
		УзлыКластеров.Вставить(СтрокаСостояния.Кластер, УзелКластера);
	КонецЦикла;
	
	Для Каждого СтрокаСостояния Из Состояния Цикл
		Если Не ЗначениеЗаполнено(СтрокаСостояния.ИнформационнаяБаза) Тогда
			Продолжить;
		КонецЕсли;
		УзелКластера = УзлыКластеров.Получить(СтрокаСостояния.Кластер);
		Если УзелКластера = Неопределено Тогда
			УзелКластера = Дерево.Строки.Добавить();
			УзелКластера.Объект = СтрокаСостояния.Кластер;
			УзелКластера.Представление = Строка(СтрокаСостояния.Кластер);
			УзлыКластеров.Вставить(СтрокаСостояния.Кластер, УзелКластера);
		КонецЕсли;
		УзелБазы = УзелКластера.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(УзелБазы, СтрокаСостояния);
		УзелБазы.Объект = СтрокаСостояния.ИнформационнаяБаза;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоБаз");
	ВосстановитьТекущуюСтрокуДерева(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ВосстановитьТекущуюСтрокуДерева(ТекущийОбъект)
	Если Не ЗначениеЗаполнено(ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = ИдентификаторСтрокиДерева(ДеревоБаз.ПолучитьЭлементы(), ТекущийОбъект);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.ДеревоБаз.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ИдентификаторСтрокиДерева(СтрокиДерева, ИскомыйОбъект)
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.Объект = ИскомыйОбъект Тогда
			Возврат СтрокаДерева.ПолучитьИдентификатор();
		КонецЕсли;
		НайденныйИдентификатор = ИдентификаторСтрокиДерева(СтрокаДерева.ПолучитьЭлементы(), ИскомыйОбъект);
		Если НайденныйИдентификатор <> Неопределено Тогда
			Возврат НайденныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьНастройкиБлокировкиНаКлиенте(ИнформационнаяБаза)
	Если Не МожноУправлятьБлокировкой Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Настройки = НастройкиБлокировкиНаСервере(ИнформационнаяБаза);
	Исключение
		ОчиститьНастройкиБлокировкиНаКлиенте();
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);
	Элементы.ГруппаУправление.Доступность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНастройкиБлокировкиНаКлиенте()
	БлокировкаСеансов = Ложь;
	БлокировкаРегламентныхЗаданий = Ложь;
	НачалоБлокировки = Дата(1, 1, 1);
	ОкончаниеБлокировки = Дата(1, 1, 1);
	СообщениеБлокировки = "";
	КодРазрешения = "";
	Элементы.ГруппаУправление.Доступность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКолонкиБлокировкиВДереве(Настройки)
	ТекущиеДанные = Элементы.ДеревоБаз.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(
		ТекущиеДанные,
		Настройки,
		"БлокировкаСеансов, БлокировкаРегламентныхЗаданий, НачалоБлокировки, ОкончаниеБлокировки");
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкиБлокировкиНаСервере(ИнформационнаяБаза)
	Возврат СеансыИнформационныхБаз.НастройкиБлокировки(ИнформационнаяБаза);
КонецФункции

&НаСервереБезКонтекста
Функция УстановитьНастройкиБлокировкиНаСервере(ИнформационнаяБаза, Настройки)
	СеансыИнформационныхБаз.УстановитьНастройкиБлокировки(ИнформационнаяБаза, Настройки);
	Возврат СеансыИнформационныхБаз.НастройкиБлокировки(ИнформационнаяБаза);
КонецФункции

&НаСервереБезКонтекста
Функция СеансыНаСервере(ИнформационнаяБаза)
	ТаблицаСеансов = СеансыИнформационныхБаз.Сеансы(ИнформационнаяБаза);
	ТаблицаСеансов.Колонки.Добавить("МожноЗавершать", Новый ОписаниеТипов("Булево"));
	Для Каждого СтрокаСеанса Из ТаблицаСеансов Цикл
		СтрокаСеанса.МожноЗавершать = ПраваУправленияСеансами.РазрешенИдентификаторКлиентаДляЗавершения(
			СтрокаСеанса.ИдентификаторПриложения);
	КонецЦикла;
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаСеансов);
КонецФункции

&НаСервереБезКонтекста
Функция ЗавершитьСеансыНаСервере(ИнформационнаяБаза, ЗавершаемыеСеансы)
	Возврат СеансыИнформационныхБаз.ЗавершитьСеансы(ИнформационнаяБаза, ЗавершаемыеСеансы);
КонецФункции

&НаСервереБезКонтекста
Процедура ЗавершитьСеансыПакетомНаСервере(ИнформационнаяБаза, ЗавершаемыеСеансы)
	СеансыИнформационныхБаз.ЗавершитьСеансыПакетом(ИнформационнаяБаза, ЗавершаемыеСеансы);
КонецПроцедуры

#КонецОбласти
