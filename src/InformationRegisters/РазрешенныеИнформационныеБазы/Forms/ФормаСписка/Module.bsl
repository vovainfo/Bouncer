#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПользовательОтбора = ПользовательОтбораСписка();
	Если Не ЗначениеЗаполнено(ПользовательОтбора) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Пользователь",
		ПользовательОтбора,
		ВидСравненияКомпоновкиДанных.Равно,
		,
		Истина);
	Элементы.Пользователь.Видимость = Ложь;
	АвтоЗаголовок = Ложь;
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Разрешенные информационные базы: %1'"),
		Строка(ПользовательОтбора));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПользовательОтбораСписка()
	
	Если ЗначениеЗаполнено(Параметры.Пользователь) Тогда
		Возврат Параметры.Пользователь;
	КонецЕсли;
	
	ПользовательОтбора = Неопределено;
	Если Параметры.Свойство("Отбор") Тогда
		Параметры.Отбор.Свойство("Пользователь", ПользовательОтбора);
	КонецЕсли;
	
	Возврат ПользовательОтбора;
	
КонецФункции

#КонецОбласти
