#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПользовательОтбора = ПользовательОтбораСписка();
	Если Не ЗначениеЗаполнено(ПользовательОтбора) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Пользователь",
		ПользовательОтбора,
		ВидСравненияКомпоновкиДанных.Равно,
		,
		Истина);
	Элементы.Пользователь.Видимость = Ложь;
	АвтоЗаголовок = Ложь;
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Разрешенные информационные базы: %1'"),
		Строка(ПользовательОтбора));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Или Не ЗначениеЗаполнено(ПользовательОтбора) Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура("Пользователь", ПользовательОтбора));
	ОткрытьФорму(
		"РегистрСведений.РазрешенныеИнформационныеБазы.ФормаЗаписи",
		ПараметрыФормы,
		Элемент,
		Новый УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПользовательОтбораСписка()
	
	Если ЗначениеЗаполнено(Параметры.Пользователь) Тогда
		Возврат Параметры.Пользователь;
	КонецЕсли;
	
	ПользовательСписка = Неопределено;
	Если Параметры.Свойство("Отбор") Тогда
		Параметры.Отбор.Свойство("Пользователь", ПользовательСписка);
	КонецЕсли;
	
	Возврат ПользовательСписка;
	
КонецФункции

#КонецОбласти
